<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PreAlert / Update</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-16x16.png" sizes="16x16" />

    <style>
        a { text-decoration: none; }
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }
        .card { border-radius: 12px; }
        .section-title {
            margin-top: 3rem;
            margin-bottom: 1rem;
        }
        .endpoint {
            font-family: monospace;
            background: #e9ecef;
            padding: 4px 8px;
            border-radius: 6px;
        }
        .premium {
            font-size: 0.875rem;
            color: #d63384;
            font-weight: 500;
        }
        nav li {
            padding: 4px;
            margin-bottom: 10px;
        }
        h1 {
            font-weight: 700;
            color: #4b0082;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        h2 {
            font-weight: 700;
            color: #4b0082;
            margin-top: 2rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        label {
            display: block;
            margin: 1rem 0 0.5rem 0;
            font-weight: 600;
            color: #555;
        }
        input[type='text'],
        input[type='number'],
        input[type='email'],
        input[type='date'],
        select,
        textarea {
            width: 100%;
            padding: 0.5rem 0.75rem;
            border: 2px solid #ddd;
            border-radius: 6px;
            font-size: 1rem;
            transition: border-color 0.3s;
            font-family: inherit;
        }
        textarea {
            resize: vertical;
            min-height: 80px;
        }
        input:focus,
        select:focus,
        textarea:focus {
            border-color: #764ba2;
            outline: none;
            box-shadow: 0 0 8px #a07ecf80;
        }
        button {
            margin-top: 1.5rem;
            background: #764ba2;
            color: white;
            font-weight: 600;
            padding: 0.75rem 1.8rem;
            font-size: 1.1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        button:hover {
            background: #4b0082;
        }
        .btn-secondary {
            background: #6c757d;
        }
        .btn-secondary:hover {
            background: #5a6268;
        }
        .btn-info {
            background: #17a2b8;
        }
        .btn-info:hover {
            background: #138496;
        }
        .button-group {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .button-group button {
            margin-top: 0;
        }
        pre {
            background: #f6f8fa;
            padding: 1rem;
            border-radius: 8px;
            margin-top: 1rem;
            font-size: 0.9rem;
            max-height: 400px;
            overflow: auto;
            border: 1px solid #ddd;
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        .instructions {
            margin-top: 3rem;
            border-top: 2px solid #764ba2;
            padding-top: 2rem;
            color: #333;
        }
        .instructions h2 {
            color: #764ba2;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        .tag {
            display: inline-block;
            background: #e1d7ff;
            color: #4b0082;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 5px;
            font-size: 0.85rem;
            margin-right: 0.5rem;
            font-family: monospace;
        }
        ul {
            margin-left: 1.25rem;
        }
        ul li {
            margin-bottom: 0.4rem;
            line-height: 1.4;
        }
        pre.example {
            background: #efefff;
            border-left: 5px solid #764ba2;
            padding-left: 1rem;
            font-family: monospace;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }
        .alert {
            margin-top: 1rem;
            padding: 0.75rem;
            border-radius: 6px;
            display: none;
        }
        .alert.show {
            display: block;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
        .badge {
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            font-weight: 500;
            font-size: 0.85rem;
        }
        .badge-pending {
            background-color: #ffc107;
            color: #856404;
        }
        .badge-synced {
            background-color: #28a745;
            color: white;
        }
        .badge-matched {
            background-color: #17a2b8;
            color: white;
        }
        .info-card {
            background: #e9ecef;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .info-card h5 {
            color: #4b0082;
            margin-bottom: 0.5rem;
        }
        .match-score {
            font-weight: 600;
            font-size: 1.2rem;
        }
        .match-score.high {
            color: #28a745;
        }
        .match-score.medium {
            color: #ffc107;
        }
        .match-score.low {
            color: #dc3545;
        }
    </style>
</head>
<body class="bg-light">

    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <%- include("../sidebar") %>

        <!-- Page content -->
        <div id="page-content" class="p-4 w-100">
            <div id="alertMessage" class="alert"></div>

            <h1><i class="bi bi-pencil-square"></i> Update PreAlert</h1>

            <div class="card shadow-sm rounded-4 p-4 mb-4">
                <h4 class="mb-3"><i class="bi bi-info-circle-fill me-2 text-primary"></i> Update Existing PreAlert</h4>
                <p>Update the details of an existing pre-alert. All fields except the ID are optional - only provided fields will be updated.</p>
            </div>

            <label for="apiKey"><i class="bi bi-key-fill"></i> API Key <span class="text-danger">*</span></label>
            <input type="text" id="apiKey" placeholder="Enter your Bearer API key here..." />

            <label for="prealertId"><i class="bi bi-lock-fill"></i> PreAlert ID (UUID) <span class="text-danger">*</span></label>
            <input type="text" id="prealertId" placeholder="Enter the encrypted UUID of the pre-alert to update" />
            
            <button onclick="fetchPreAlert()" class="btn-info" style="margin-top: 0.5rem;">
                <i class="bi bi-search"></i> Fetch PreAlert Details
            </button>

            <div id="currentDetails" style="display: none;" class="info-card">
                <h5><i class="bi bi-info-circle"></i> Current Details</h5>
                <div class="form-row">
                    <div><strong>Tracking #:</strong> <span id="currentTrackingNo"></span></div>
                    <div><strong>Status:</strong> <span id="currentStatus"></span></div>
                    <div><strong>Merchant:</strong> <span id="currentMerchant"></span></div>
                    <div><strong>Consignee:</strong> <span id="currentConsignee"></span></div>
                    <div><strong>Match Score:</strong> <span id="currentMatchScore"></span></div>
                </div>
            </div>

            <h2 class="mt-4"><i class="bi bi-pencil"></i> Fields to Update</h2>
            <p class="text-muted">Leave fields empty to keep current values</p>

            <div class="form-row">
                <div>
                    <label for="trackingNo">Tracking Number</label>
                    <input type="text" id="trackingNo" placeholder="New tracking number" />
                </div>
                <div>
                    <label for="merchant">Merchant</label>
                    <input type="text" id="merchant" placeholder="Merchant name" />
                </div>
            </div>

            <div class="form-row">
                <div>
                    <label for="shipper">Shipper</label>
                    <input type="text" id="shipper" placeholder="Shipper name" />
                </div>
                <div>
                    <label for="consignee">Consignee</label>
                    <input type="text" id="consignee" placeholder="Consignee name" />
                </div>
            </div>

            <div class="form-row">
                <div>
                    <label for="weight">Weight (kg)</label>
                    <input type="number" id="weight" placeholder="Weight in kg" step="0.01" />
                </div>
                <div>
                    <label for="dimensions">Dimensions</label>
                    <input type="text" id="dimensions" placeholder="L x W x H" />
                </div>
            </div>

            <div class="form-row">
                <div>
                    <label for="value">Value ($)</label>
                    <input type="number" id="value" placeholder="Declared value" step="0.01" />
                </div>
                <div>
                    <label for="packageType">Package Type</label>
                    <select id="packageType">
                        <option value="">-- Keep current --</option>
                        <option value="box">Box</option>
                        <option value="envelope">Envelope</option>
                        <option value="pallet">Pallet</option>
                        <option value="crate">Crate</option>
                        <option value="tube">Tube</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div>
                    <label for="destination">Destination</label>
                    <input type="text" id="destination" placeholder="Destination address" />
                </div>
                <div>
                    <label for="expectedArrival">Expected Arrival Date</label>
                    <input type="date" id="expectedArrival" />
                </div>
            </div>

            <div>
                <label for="status">Status</label>
                <select id="status">
                    <option value="">-- Keep current --</option>
                    <option value="pending">Pending</option>
                    <option value="synced">Synced</option>
                    <option value="matched">Matched</option>
                    <option value="failed">Failed</option>
                </select>
            </div>

            <div>
                <label for="description">Description</label>
                <textarea id="description" placeholder="Package description"></textarea>
            </div>

            <div class="button-group">
                <button onclick="updatePreAlert()">
                    <i class="bi bi-send"></i> Update PreAlert
                </button>
                <button onclick="clearForm()" class="btn-secondary">
                    <i class="bi bi-eraser"></i> Clear Form
                </button>
                <button onclick="resetToCurrent()" class="btn-secondary" id="resetBtn" style="display: none;">
                    <i class="bi bi-arrow-repeat"></i> Reset to Current
                </button>
            </div>

            <h2><i class="bi bi-file-earmark-code"></i> Response</h2>
            <pre id="response">Waiting for response...</pre>

            <div class="instructions">
                <h2><i class="bi bi-code-slash"></i> Developer Instructions (Without Widget)</h2>

                <p>Make a <span class="tag">PUT</span> request to:</p>
                <pre class="example">https://waresync.onepluscourierja.com/api/prealert/update/:id</pre>

                <p><strong>Authorization Header:</strong></p>
                <pre class="example">Authorization: Bearer YOUR_API_KEY</pre>

                <p><strong>Request Body:</strong> <span class="premium">(JSON - All fields optional)</span></p>
                <pre class="example">
{
  "tracking_no": "TRK123456789",
  "merchant": "Amazon",
  "shipper": "John Doe",
  "consignee": "Jane Smith",
  "weight": 2.5,
  "dimensions": "30x20x10",
  "value": 150.00,
  "package_type": "box",
  "destination": "Kingston, Jamaica",
  "expected_arrival": "2024-03-15",
  "description": "Electronics and accessories",
  "status": "matched"
}
                </pre>

                <p><strong>Required Field:</strong></p>
                <ul>
                    <li><code>id</code> — The encrypted UUID of the pre-alert (in URL path)</li>
                </ul>

                <p><strong>Optional Fields (all others):</strong></p>
                <ul>
                    <li><code>tracking_no</code> — Tracking number of the package</li>
                    <li><code>merchant</code> — Merchant/store name</li>
                    <li><code>shipper</code> — Shipper name</li>
                    <li><code>consignee</code> — Consignee name</li>
                    <li><code>weight</code> — Package weight (kg)</li>
                    <li><code>dimensions</code> — Package dimensions (L x W x H)</li>
                    <li><code>value</code> — Declared value</li>
                    <li><code>package_type</code> — Type of package</li>
                    <li><code>destination</code> — Destination address</li>
                    <li><code>expected_arrival</code> — Expected arrival date</li>
                    <li><code>description</code> — Package description</li>
                    <li><code>status</code> — New status (pending, synced, matched, failed)</li>
                </ul>

                <p><strong>Example using <code>curl</code>:</strong></p>
                <pre class="example">
curl -X PUT "https://waresync.onepluscourierja.com/api/prealert/update/encrypted_id_here" \
     -H "Authorization: Bearer YOUR_API_KEY" \
     -H "Content-Type: application/json" \
     -d '{
           "tracking_no": "TRK123456789",
           "merchant": "Amazon",
           "status": "matched"
         }'
                </pre>

                <p><strong>Example using JavaScript <code>fetch</code>:</strong></p>
                <pre class="example">
fetch("https://waresync.onepluscourierja.com/api/prealert/update/encrypted_id_here", {
  method: "PUT",
  headers: {
    "Content-Type": "application/json",
    "Authorization": "Bearer YOUR_API_KEY"
  },
  body: JSON.stringify({
    tracking_no: "TRK123456789",
    merchant: "Amazon",
    weight: 2.5,
    status: "matched"
  })
})
.then(res => res.json())
.then(data => console.log(data));
                </pre>

                <h3 class="mt-4"><i class="bi bi-exclamation-triangle-fill"></i> Important Notes</h3>
                <ul>
                    <li>The ID must be the encrypted UUID returned from the list endpoint</li>
                    <li>Only fields that are provided will be updated - empty fields are ignored</li>
                    <li>You cannot update the courier_id or company_id through this endpoint</li>
                    <li>Updates are synced to the external warehouse system automatically</li>
                    <li>Match score may be recalculated if tracking number is changed</li>
                </ul>

                <h3 class="mt-4"><i class="bi bi-tags"></i> Status Transitions</h3>
                <ul>
                    <li><span class="badge badge-pending">Pending</span> → <span class="badge badge-matched">Matched</span> or <span class="badge badge-synced">Synced</span> or <span class="badge badge-pending">Failed</span></li>
                    <li><span class="badge badge-matched">Matched</span> → <span class="badge badge-synced">Synced</span> (after processing)</li>
                    <li><span class="badge badge-synced">Synced</span> → Cannot be changed back (read-only after sync)</li>
                    <li><span class="badge badge-failed">Failed</span> → <span class="badge badge-pending">Pending</span> (retry)</li>
                </ul>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentPreAlert = null;

        function showAlert(message, type = 'danger') {
            const alertDiv = document.getElementById('alertMessage');
            alertDiv.className = `alert alert-${type} show`;
            alertDiv.textContent = message;
            setTimeout(() => {
                alertDiv.classList.remove('show');
            }, 5000);
        }

        function getStatusBadge(status) {
            const statusMap = {
                'pending': '<span class="badge badge-pending">PENDING</span>',
                'synced': '<span class="badge badge-synced">SYNCED</span>',
                'matched': '<span class="badge badge-matched">MATCHED</span>',
                'failed': '<span class="badge badge-pending">FAILED</span>'
            };
            return statusMap[status] || `<span class="badge badge-pending">${(status || 'UNKNOWN').toUpperCase()}</span>`;
        }

        function getMatchScoreClass(score) {
            if (!score) return '';
            if (score >= 80) return 'high';
            if (score >= 50) return 'medium';
            return 'low';
        }

        async function fetchPreAlert() {
            const apiKey = document.getElementById('apiKey').value.trim();
            const prealertId = document.getElementById('prealertId').value.trim();

            if (!apiKey || !prealertId) {
                showAlert('Please enter both API key and PreAlert ID.', 'danger');
                return;
            }

            try {
                const response = await fetch(`https://waresync.onepluscourierja.com/api/prealert/list`, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Accept': 'application/json',
                    },
                });

                const data = await response.json();
                
                if (!response.ok) {
                    throw new Error(data.error || response.statusText);
                }

                // Find the specific pre-alert by UUID
                const found = data.data.find(item => item.uuid === prealertId);
                
                if (!found) {
                    showAlert('PreAlert not found with the provided ID.', 'warning');
                    document.getElementById('currentDetails').style.display = 'none';
                    document.getElementById('resetBtn').style.display = 'none';
                    return;
                }

                currentPreAlert = found;
                displayCurrentDetails(found);
                showAlert('PreAlert details loaded successfully', 'success');
                
            } catch (error) {
                document.getElementById('response').textContent = `Error: ${error.message}`;
                showAlert(`Error fetching pre-alert: ${error.message}`, 'danger');
            }
        }

        function displayCurrentDetails(preAlert) {
            const matchScoreClass = getMatchScoreClass(preAlert.match_score);
            const matchScoreDisplay = preAlert.match_score ? 
                `<span class="match-score ${matchScoreClass}">${preAlert.match_score}%</span>` : 'N/A';
            
            document.getElementById('currentTrackingNo').innerHTML = `<strong>${escapeHtml(preAlert.tracking_no || 'N/A')}</strong>`;
            document.getElementById('currentStatus').innerHTML = getStatusBadge(preAlert.status);
            document.getElementById('currentMerchant').textContent = preAlert.merchant || 'N/A';
            document.getElementById('currentConsignee').textContent = preAlert.consignee || 'N/A';
            document.getElementById('currentMatchScore').innerHTML = matchScoreDisplay;
            
            document.getElementById('currentDetails').style.display = 'block';
            document.getElementById('resetBtn').style.display = 'inline-flex';
        }

        function resetToCurrent() {
            if (!currentPreAlert) return;
            
            // Don't reset the ID field
            document.getElementById('trackingNo').value = '';
            document.getElementById('merchant').value = '';
            document.getElementById('shipper').value = '';
            document.getElementById('consignee').value = '';
            document.getElementById('weight').value = '';
            document.getElementById('dimensions').value = '';
            document.getElementById('value').value = '';
            document.getElementById('packageType').value = '';
            document.getElementById('destination').value = '';
            document.getElementById('expectedArrival').value = '';
            document.getElementById('status').value = '';
            document.getElementById('description').value = '';
            
            showAlert('Form reset - only fields you fill will be updated', 'info');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        async function updatePreAlert() {
            const apiKey = document.getElementById('apiKey').value.trim();
            const prealertId = document.getElementById('prealertId').value.trim();

            if (!apiKey || !prealertId) {
                showAlert('API key and PreAlert ID are required.', 'danger');
                return;
            }

            // Build payload with only provided fields
            const payload = {};
            
            const trackingNo = document.getElementById('trackingNo').value.trim();
            if (trackingNo) payload.tracking_no = trackingNo;
            
            const merchant = document.getElementById('merchant').value.trim();
            if (merchant) payload.merchant = merchant;
            
            const shipper = document.getElementById('shipper').value.trim();
            if (shipper) payload.shipper = shipper;
            
            const consignee = document.getElementById('consignee').value.trim();
            if (consignee) payload.consignee = consignee;
            
            const weight = document.getElementById('weight').value;
            if (weight) payload.weight = parseFloat(weight);
            
            const dimensions = document.getElementById('dimensions').value.trim();
            if (dimensions) payload.dimensions = dimensions;
            
            const value = document.getElementById('value').value;
            if (value) payload.value = parseFloat(value);
            
            const packageType = document.getElementById('packageType').value;
            if (packageType) payload.package_type = packageType;
            
            const destination = document.getElementById('destination').value.trim();
            if (destination) payload.destination = destination;
            
            const expectedArrival = document.getElementById('expectedArrival').value;
            if (expectedArrival) payload.expected_arrival = expectedArrival;
            
            const status = document.getElementById('status').value;
            if (status) payload.status = status;
            
            const description = document.getElementById('description').value.trim();
            if (description) payload.description = description;

            if (Object.keys(payload).length === 0) {
                showAlert('No fields to update. Please fill at least one field.', 'warning');
                return;
            }

            if (!confirm('Are you sure you want to update this pre-alert?')) {
                return;
            }

            try {
                const response = await fetch(`/api/prealert/update/${encodeURIComponent(prealertId)}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                document.getElementById('response').textContent = JSON.stringify(result, null, 2);
                
                if (response.ok) {
                    showAlert('PreAlert updated successfully!', 'success');
                    // Refresh the current details
                    if (currentPreAlert) {
                        await fetchPreAlert();
                    }
                } else {
                    showAlert(result.message || result.error || 'Failed to update pre-alert', 'danger');
                }
            } catch (error) {
                document.getElementById('response').textContent = `Error: ${error.message}`;
                showAlert(`Error: ${error.message}`, 'danger');
            }
        }

        function clearForm() {
            document.getElementById('prealertId').value = '';
            document.getElementById('trackingNo').value = '';
            document.getElementById('merchant').value = '';
            document.getElementById('shipper').value = '';
            document.getElementById('consignee').value = '';
            document.getElementById('weight').value = '';
            document.getElementById('dimensions').value = '';
            document.getElementById('value').value = '';
            document.getElementById('packageType').value = '';
            document.getElementById('destination').value = '';
            document.getElementById('expectedArrival').value = '';
            document.getElementById('status').value = '';
            document.getElementById('description').value = '';
            document.getElementById('currentDetails').style.display = 'none';
            document.getElementById('resetBtn').style.display = 'none';
            document.getElementById('response').textContent = 'Waiting for response...';
            currentPreAlert = null;
            showAlert('Form cleared', 'info');
        }

        // Optional: Add enter key support for fetching
        document.getElementById('prealertId')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                fetchPreAlert();
            }
        });
    </script>
</body>
</html>