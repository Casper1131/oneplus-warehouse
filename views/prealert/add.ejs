<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>PreAlert / Add</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

        <link rel="stylesheet" href="/styles.css">

        <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-32x32.png" sizes="32x32" />
        <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-16x16.png" sizes="16x16" />

        <style>
            a{
                text-decoration:none
            }
            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', sans-serif;
            }
            .card {
                border-radius: 12px;
            }
            .section-title {
                margin-top: 3rem;
                margin-bottom: 1rem;
            }
            .endpoint {
                font-family: monospace;
                background: #e9ecef;
                padding: 4px 8px;
                border-radius: 6px;
            }
            .premium {
                font-size: 0.875rem;
                color: #d63384;
                font-weight: 500;
            }
            nav li{
                padding:4px;
                margin-bottom:10px
            }
            h1 {
                font-weight: 700;
                color: #4b0082;
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            label {
                display: block;
                margin: 1rem 0 0.5rem 0;
                font-weight: 600;
                color: #555;
            }

            input[type='text'],
            input[type='number'],
            input[type='email'],
            input[type='date'],
            select {
                width: 100%;
                padding: 0.5rem 0.75rem;
                border: 2px solid #ddd;
                border-radius: 6px;
                font-size: 1rem;
                transition: border-color 0.3s;
            }

            input[type='text']:focus,
            input[type='number']:focus,
            input[type='email']:focus,
            input[type='date']:focus,
            select:focus {
                border-color: #764ba2;
                outline: none;
                box-shadow: 0 0 8px #a07ecf80;
            }

            button {
                margin-top: 1.5rem;
                background: #764ba2;
                color: white;
                font-weight: 600;
                padding: 0.75rem 1.8rem;
                font-size: 1.1rem;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                transition: background-color 0.3s;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            button:hover {
                background: #4b0082;
            }

            .button-group {
                display: flex;
                gap: 1rem;
                margin-top: 1.5rem;
            }

            .button-group button {
                margin-top: 0;
            }

            .btn-secondary {
                background: #6c757d;
            }

            .btn-secondary:hover {
                background: #5a6268;
            }

            .btn-info {
                background: #17a2b8;
            }

            .btn-info:hover {
                background: #138496;
            }

            pre {
                background: #f6f8fa;
                padding: 1rem;
                border-radius: 8px;
                margin-top: 1rem;
                font-size: 0.9rem;
                max-height: 300px;
                overflow: auto;
                border: 1px solid #ddd;
                white-space: pre-wrap;
                word-wrap: break-word;
            }

            .instructions {
                margin-top: 3rem;
                border-top: 2px solid #764ba2;
                padding-top: 2rem;
                color: #333;
            }

            .instructions h2 {
                color: #764ba2;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-bottom: 1rem;
            }

            .tag {
                display: inline-block;
                background: #e1d7ff;
                color: #4b0082;
                font-weight: 700;
                padding: 0.15rem 0.5rem;
                border-radius: 5px;
                font-size: 0.85rem;
                margin-right: 0.5rem;
                font-family: monospace;
            }

            ul {
                margin-left: 1.25rem;
            }

            ul li {
                margin-bottom: 0.4rem;
                line-height: 1.4;
            }

            pre.example {
                background: #efefff;
                border-left: 5px solid #764ba2;
                padding-left: 1rem;
                font-family: monospace;
                font-size: 0.9rem;
                margin-bottom: 1rem;
            }

            .alert {
                margin-top: 1rem;
                padding: 0.75rem;
                border-radius: 6px;
                display: none;
            }

            .alert.show {
                display: block;
            }

            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1rem;
            }

            @media (max-width: 768px) {
                .form-row {
                    grid-template-columns: 1fr;
                }
            }
        </style>
    </head>
    <body class="bg-light">

        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <%- include("../sidebar") %>

            <!-- Page content -->
            <div id="page-content" class="p-4 w-100">
                <h1><i class="bi bi-plus-circle"></i> Add PreAlert</h1>

                <div id="alertMessage" class="alert"></div>

                <label for="apiKey">API Key <span class="text-danger">*</span></label>
                <input type="text" id="apiKey" placeholder="Bearer API Key" />

                <label for="trackingNo">Tracking Number <span class="text-danger">*</span></label>
                <input type="text" id="trackingNo" placeholder="Tracking Number" />

                <div class="form-row">
                    <div>
                        <label for="merchant">Merchant</label>
                        <input type="text" id="merchant" placeholder="Merchant Name" />
                    </div>
                    <div>
                        <label for="shipper">Shipper</label>
                        <input type="text" id="shipper" placeholder="Shipper Name" />
                    </div>
                </div>

                <label for="consignee">Consignee</label>
                <input type="text" id="consignee" placeholder="Consignee Name" />

                <div class="form-row">
                    <div>
                        <label for="weight">Weight (kg)</label>
                        <input type="number" id="weight" placeholder="Weight" step="0.01" />
                    </div>
                    <div>
                        <label for="dimensions">Dimensions</label>
                        <input type="text" id="dimensions" placeholder="L x W x H" />
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label for="value">Value ($)</label>
                        <input type="number" id="value" placeholder="Declared Value" step="0.01" />
                    </div>
                    <div>
                        <label for="packageType">Package Type</label>
                        <select id="packageType">
                            <option value="">Select Package Type</option>
                            <option value="box">Box</option>
                            <option value="envelope">Envelope</option>
                            <option value="pallet">Pallet</option>
                            <option value="crate">Crate</option>
                            <option value="tube">Tube</option>
                        </select>
                    </div>
                </div>

                <label for="destination">Destination</label>
                <input type="text" id="destination" placeholder="Destination Address" />

                <label for="expectedArrival">Expected Arrival Date</label>
                <input type="date" id="expectedArrival" />

                <label for="description">Description</label>
                <input type="text" id="description" placeholder="Package Description" />

                <div class="button-group">
                    <button onclick="addPreAlert()">
                        <i class="bi bi-upload"></i> Submit
                    </button>
                    <button onclick="clearForm()" class="btn-secondary">
                        <i class="bi bi-eraser"></i> Clear
                    </button>
                </div>

                <pre id="response">Waiting for response...</pre>

                <div class="instructions">
                    <h2><i class="bi bi-code-slash"></i> Developer Instructions (Without Widget)</h2>

                    <p>Make a <span class="tag">POST</span> request to:</p>
                    <pre class="example">https://waresync.onepluscourierja.com/api/prealert/add</pre>

                    <p><strong>Authorization Header:</strong></p>
                    <pre class="example">Authorization: Bearer YOUR_API_KEY</pre>

                    <p><strong>Request Body:</strong> <span class="premium">(JSON)</span></p>
                    <pre class="example">
{
  "tracking_no": "TRK123456789",
  "merchant": "Amazon",
  "shipper": "John Doe",
  "consignee": "Jane Smith",
  "weight": 2.5,
  "dimensions": "30x20x10",
  "value": 150.00,
  "package_type": "box",
  "destination": "Kingston, Jamaica",
  "expected_arrival": "2024-03-15",
  "description": "Electronics and accessories"
}
                    </pre>

                    <p><strong>Required Fields:</strong></p>
                    <ul>
                        <li><code>tracking_no</code> — Tracking number of the package</li>
                    </ul>

                    <p><strong>Optional Fields:</strong></p>
                    <ul>
                        <li><code>merchant</code> — Merchant/store name</li>
                        <li><code>shipper</code> — Shipper name</li>
                        <li><code>consignee</code> — Consignee name</li>
                        <li><code>weight</code> — Package weight (kg)</li>
                        <li><code>dimensions</code> — Package dimensions (L x W x H)</li>
                        <li><code>value</code> — Declared value</li>
                        <li><code>package_type</code> — Type of package</li>
                        <li><code>destination</code> — Destination address</li>
                        <li><code>expected_arrival</code> — Expected arrival date</li>
                        <li><code>description</code> — Package description</li>
                    </ul>

                    <p><strong>Example using <code>curl</code>:</strong></p>
                    <pre class="example">
curl -X POST "https://waresync.onepluscourierja.com/api/prealert/add" \
     -H "Authorization: Bearer YOUR_API_KEY" \
     -H "Content-Type: application/json" \
     -d '{
           "tracking_no": "TRK123456789",
           "merchant": "Amazon",
           "shipper": "John Doe",
           "consignee": "Jane Smith",
           "weight": 2.5,
           "dimensions": "30x20x10",
           "value": 150.00,
           "package_type": "box",
           "destination": "Kingston, Jamaica",
           "expected_arrival": "2024-03-15",
           "description": "Electronics and accessories"
         }'
                    </pre>

                    <p><strong>Example using JavaScript <code>fetch</code>:</strong></p>
                    <pre class="example">
fetch("https://waresync.onepluscourierja.com/api/prealert/add", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "Authorization": "Bearer YOUR_API_KEY"
  },
  body: JSON.stringify({
    tracking_no: "TRK123456789",
    merchant: "Amazon",
    shipper: "John Doe",
    consignee: "Jane Smith",
    weight: 2.5,
    dimensions: "30x20x10",
    value: 150.00,
    package_type: "box",
    destination: "Kingston, Jamaica",
    expected_arrival: "2024-03-15",
    description: "Electronics and accessories"
  })
})
.then(res => res.json())
.then(data => console.log(data));
                    </pre>

                    
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            function showAlert(message, type = 'danger') {
                const alertDiv = document.getElementById('alertMessage');
                alertDiv.className = `alert alert-${type} show`;
                alertDiv.textContent = message;
                setTimeout(() => {
                    alertDiv.classList.remove('show');
                }, 5000);
            }

            async function addPreAlert() {
                const apiKey = document.getElementById('apiKey').value.trim();
                const tracking_no = document.getElementById('trackingNo').value.trim();
                const merchant = document.getElementById('merchant').value.trim();
                const shipper = document.getElementById('shipper').value.trim();
                const consignee = document.getElementById('consignee').value.trim();
                const weight = document.getElementById('weight').value;
                const dimensions = document.getElementById('dimensions').value.trim();
                const value = document.getElementById('value').value;
                const package_type = document.getElementById('packageType').value;
                const destination = document.getElementById('destination').value.trim();
                const expected_arrival = document.getElementById('expectedArrival').value;
                const description = document.getElementById('description').value.trim();

                if (!apiKey || !tracking_no) {
                    showAlert('API Key and Tracking Number are required.', 'danger');
                    return;
                }

                const payload = {
                    tracking_no,
                    merchant: merchant || null,
                    shipper: shipper || null,
                    consignee: consignee || null,
                    weight: weight ? parseFloat(weight) : null,
                    dimensions: dimensions || null,
                    value: value ? parseFloat(value) : null,
                    package_type: package_type || null,
                    destination: destination || null,
                    expected_arrival: expected_arrival || null,
                    description: description || null
                };

                try {
                    const response = await fetch('https://waresync.onepluscourierja.com/api/prealert/add', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();
                    document.getElementById('response').textContent = JSON.stringify(result, null, 2);
                    
                    if (response.ok) {
                        showAlert('PreAlert added successfully!', 'success');
                        if (confirm('PreAlert added successfully. Would you like to clear the form?')) {
                            clearForm();
                        }
                    } else {
                        showAlert(result.message || result.error || 'Failed to add PreAlert', 'danger');
                    }
                } catch (error) {
                    document.getElementById('response').textContent = `Error: ${error.message}`;
                    showAlert(`Error: ${error.message}`, 'danger');
                }
            }

            async function syncPreAlerts() {
                const apiKey = document.getElementById('apiKey').value.trim();
                
                if (!apiKey) {
                    showAlert('API Key is required for sync.', 'danger');
                    return;
                }

                // You can modify this to collect multiple pre-alerts from a list or table
                const preAlerts = [
                    {
                        tracking_no: document.getElementById('trackingNo').value.trim(),
                        merchant: document.getElementById('merchant').value.trim(),
                        shipper: document.getElementById('shipper').value.trim(),
                        consignee: document.getElementById('consignee').value.trim(),
                        weight: document.getElementById('weight').value ? parseFloat(document.getElementById('weight').value) : null,
                        dimensions: document.getElementById('dimensions').value.trim(),
                        value: document.getElementById('value').value ? parseFloat(document.getElementById('value').value) : null,
                        package_type: document.getElementById('packageType').value,
                        destination: document.getElementById('destination').value.trim(),
                        expected_arrival: document.getElementById('expectedArrival').value,
                        description: document.getElementById('description').value.trim()
                    }
                ].filter(alert => alert.tracking_no); // Only include if tracking number exists

                if (preAlerts.length === 0) {
                    showAlert('No pre-alerts to sync. Please fill in at least one tracking number.', 'warning');
                    return;
                }

                try {
                    const response = await fetch('https://waresync.onepluscourierja.com/api/prealert/sync', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify({ pre_alerts: preAlerts })
                    });

                    const result = await response.json();
                    document.getElementById('response').textContent = JSON.stringify(result, null, 2);
                    
                    if (response.ok) {
                        showAlert(`Successfully synced ${preAlerts.length} pre-alert(s)!`, 'success');
                    } else {
                        showAlert(result.message || result.error || 'Failed to sync pre-alerts', 'danger');
                    }
                } catch (error) {
                    document.getElementById('response').textContent = `Error: ${error.message}`;
                    showAlert(`Error: ${error.message}`, 'danger');
                }
            }

            function clearForm() {
                document.getElementById('trackingNo').value = '';
                document.getElementById('merchant').value = '';
                document.getElementById('shipper').value = '';
                document.getElementById('consignee').value = '';
                document.getElementById('weight').value = '';
                document.getElementById('dimensions').value = '';
                document.getElementById('value').value = '';
                document.getElementById('packageType').value = '';
                document.getElementById('destination').value = '';
                document.getElementById('expectedArrival').value = '';
                document.getElementById('description').value = '';
                document.getElementById('response').textContent = 'Waiting for response...';
                showAlert('Form cleared', 'info');
            }

            // Optional: Add enter key support
            document.getElementById('trackingNo')?.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    addPreAlert();
                }
            });
        </script>
    </body>
</html>