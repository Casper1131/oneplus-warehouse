<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PreAlert / Delete</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-16x16.png" sizes="16x16" />
    <style>
        a {
            text-decoration: none;
        }
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }
        .card {
            border-radius: 12px;
        }
        .section-title {
            margin-top: 3rem;
            margin-bottom: 1rem;
        }
        .endpoint {
            font-family: monospace;
            background: #e9ecef;
            padding: 4px 8px;
            border-radius: 6px;
        }
        .premium {
            font-size: 0.875rem;
            color: #d63384;
            font-weight: 500;
        }
        nav li {
            padding: 4px;
            margin-bottom: 10px;
        }
        h1 {
            font-weight: 700;
            color: #4b0082;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        h2 {
            font-weight: 700;
            color: #4b0082;
            margin-top: 2rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        label {
            display: block;
            margin: 1rem 0 0.5rem 0;
            font-weight: 600;
            color: #555;
        }
        input[type='text'],
        input[type='number'],
        select {
            width: 100%;
            padding: 0.5rem 0.75rem;
            border: 2px solid #ddd;
            border-radius: 6px;
            font-size: 1rem;
            transition: border-color 0.3s;
        }
        input[type='text']:focus,
        input[type='number']:focus,
        select:focus {
            border-color: #764ba2;
            outline: none;
            box-shadow: 0 0 8px #a07ecf80;
        }
        button {
            margin-top: 1.5rem;
            background: #764ba2;
            color: white;
            font-weight: 600;
            padding: 0.75rem 1.8rem;
            font-size: 1.1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        button:hover {
            background: #4b0082;
        }
        .btn-danger {
            background: #dc3545;
        }
        .btn-danger:hover {
            background: #c82333;
        }
        .btn-info {
            background: #17a2b8;
        }
        .btn-info:hover {
            background: #138496;
        }
        .btn-secondary {
            background: #6c757d;
        }
        .btn-secondary:hover {
            background: #5a6268;
        }
        .button-group {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .button-group button {
            margin-top: 0;
        }
        pre {
            background: #f6f8fa;
            padding: 1rem;
            border-radius: 8px;
            margin-top: 1rem;
            font-size: 0.9rem;
            max-height: 400px;
            overflow: auto;
            border: 1px solid #ddd;
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        .instructions {
            margin-top: 3rem;
            border-top: 2px solid #764ba2;
            padding-top: 2rem;
            color: #333;
        }
        .instructions h2 {
            color: #764ba2;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        .tag {
            display: inline-block;
            background: #e1d7ff;
            color: #4b0082;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 5px;
            font-size: 0.85rem;
            margin-right: 0.5rem;
            font-family: monospace;
        }
        ul {
            margin-left: 1.25rem;
        }
        ul li {
            margin-bottom: 0.4rem;
            line-height: 1.4;
        }
        pre.example {
            background: #efefff;
            border-left: 5px solid #764ba2;
            padding-left: 1rem;
            font-family: monospace;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }
        .alert {
            margin-top: 1rem;
            padding: 0.75rem;
            border-radius: 6px;
            display: none;
        }
        .alert.show {
            display: block;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
        .search-section {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            border: 1px solid #e9ecef;
        }
        .table-responsive {
            margin-top: 1rem;
        }
        .table {
            background: white;
            border-radius: 8px;
            overflow: hidden;
        }
        .table th {
            background: #764ba2;
            color: white;
            border: none;
        }
        .table td {
            vertical-align: middle;
        }
        .badge {
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            font-weight: 500;
        }
        .badge-pending {
            background-color: #ffc107;
            color: #856404;
        }
        .badge-synced {
            background-color: #28a745;
            color: white;
        }
        .badge-matched {
            background-color: #17a2b8;
            color: white;
        }
        .loading {
            display: none;
            text-align: center;
            padding: 2rem;
        }
        .loading.show {
            display: block;
        }
    </style>
</head>
<body class="bg-light">
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <%- include("../sidebar") %>

        <!-- Page content -->
        <div id="page-content" class="p-4 w-100">
            <div id="alertMessage" class="alert"></div>

            <h1><i class="bi bi-trash-fill"></i> PreAlert Management</h1>
            
            <div class="card shadow-sm rounded-4 p-4 mb-4">
                <h4 class="mb-3"><i class="bi bi-info-circle-fill me-2 text-primary"></i> Overview</h4>
                <p>Our system provides RESTful APIs to manage PreAlerts. Use the search functionality below to find and delete pre-alerts, or use the delete form to remove a specific pre-alert by its encrypted ID.</p>
            </div>

            <!-- Search Section -->
            <div class="search-section">
                <h2><i class="bi bi-search"></i> Search PreAlerts</h2>
                
                <label for="apiKey"><i class="bi bi-key-fill"></i> API Key <span class="text-danger">*</span></label>
                <input type="text" id="apiKey" placeholder="Enter your Bearer API key here..." />

                <div class="form-row">
                    <div>
                        <label for="search"><i class="bi bi-filter"></i> Search</label>
                        <input type="text" id="search" placeholder="Search by tracking number, merchant, consignee..." />
                    </div>
                    <div>
                        <label for="status"><i class="bi bi-tag"></i> Status</label>
                        <select id="status">
                            <option value="">All Status</option>
                            <option value="pending">Pending</option>
                            <option value="synced">Synced</option>
                            <option value="matched">Matched</option>
                            <option value="failed">Failed</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label for="page"><i class="bi bi-grid"></i> Page</label>
                        <input type="number" id="page" value="1" min="1" />
                    </div>
                    <div>
                        <label for="perPage"><i class="bi bi-list-ul"></i> Per Page</label>
                        <input type="number" id="perPage" value="10" min="1" max="100" />
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label for="sortBy"><i class="bi bi-sort-alpha-down"></i> Sort By</label>
                        <select id="sortBy">
                            <option value="created_at">Created Date</option>
                            <option value="tracking_no">Tracking Number</option>
                            <option value="merchant">Merchant</option>
                            <option value="status">Status</option>
                            <option value="expected_arrival">Expected Arrival</option>
                        </select>
                    </div>
                    <div>
                        <label for="sortDir"><i class="bi bi-arrow-down-up"></i> Sort Direction</label>
                        <select id="sortDir">
                            <option value="desc">Descending</option>
                            <option value="asc">Ascending</option>
                        </select>
                    </div>
                </div>

                <div class="button-group">
                    <button onclick="searchPreAlerts()" class="btn-info">
                        <i class="bi bi-search"></i> Search
                    </button>
                    <button onclick="clearSearch()" class="btn-secondary">
                        <i class="bi bi-eraser"></i> Clear
                    </button>
                </div>

                <div class="loading" id="loading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading pre-alerts...</p>
                </div>

                <div class="table-responsive" id="resultsTable" style="display: none;">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>UUID</th>
                                <th>Tracking #</th>
                                <th>Merchant</th>
                                <th>Consignee</th>
                                <th>Weight</th>
                                <th>Status</th>
                                <th>Match Score</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="preAlertTableBody">
                        </tbody>
                    </table>
                    <div id="pagination" class="d-flex justify-content-between align-items-center mt-3"></div>
                </div>
            </div>

            <!-- Delete Section -->
            <h2><i class="bi bi-trash-fill"></i> Delete PreAlert</h2>
            <div class="card shadow-sm rounded-4 p-4">
                <label for="deleteId"><i class="bi bi-lock-fill"></i> Encrypted ID to Delete</label>
                <input type="text" id="deleteId" placeholder="Enter encrypted pre-alert ID (UUID)..." />
                <div class="button-group">
                    <button class="btn-danger" onclick="deletePreAlert()">
                        <i class="bi bi-trash"></i> Delete PreAlert
                    </button>
                    <button class="btn-secondary" onclick="clearDeleteForm()">
                        <i class="bi bi-eraser"></i> Clear
                    </button>
                </div>
            </div>

            <h2><i class="bi bi-file-earmark-code"></i> Response</h2>
            <pre id="response">Waiting for request...</pre>

            <!-- Developer Instructions -->
            <div class="instructions">
                <h2><i class="bi bi-code-slash"></i> Developer Instructions (Without Widget)</h2>

                <p><strong>List PreAlerts:</strong> Make a <span class="tag">GET</span> request to:</p>
                <pre class="example">https://waresync.onepluscourierja.com/api/prealert/list</pre>

                <p><strong>Authorization Header:</strong></p>
                <pre class="example">Authorization: Bearer YOUR_API_KEY</pre>

                <p><strong>Query Parameters:</strong></p>
                <ul>
                    <li><code>page</code> — Page number (default: 1)</li>
                    <li><code>perPage</code> — Items per page (default: 10, max: 100)</li>
                    <li><code>search</code> — Search term (tracking number, merchant, consignee)</li>
                    <li><code>status</code> — Filter by status (pending, synced, matched, failed)</li>
                    <li><code>sortBy</code> — Sort field (created_at, tracking_no, merchant, status, expected_arrival)</li>
                    <li><code>sortDir</code> — Sort direction (asc, desc)</li>
                </ul>

                <p><strong>Delete PreAlert:</strong> Make a <span class="tag">DELETE</span> request to:</p>
                <pre class="example">https://waresync.onepluscourierja.com/api/prealert/delete/{encrypted_id}</pre>

                <p><strong>Example using <code>curl</code> to list pre-alerts:</strong></p>
                <pre class="example">
curl -X GET "https://waresync.onepluscourierja.com/api/prealert/list?page=1&perPage=10&status=pending" \
     -H "Authorization: Bearer YOUR_API_KEY" \
     -H "Accept: application/json"
                </pre>

                <p><strong>Example using <code>curl</code> to delete a pre-alert:</strong></p>
                <pre class="example">
curl -X DELETE "https://waresync.onepluscourierja.com/api/prealert/delete/encrypted_id_here" \
     -H "Authorization: Bearer YOUR_API_KEY" \
     -H "Accept: application/json"
                </pre>

                <p><strong>Example using JavaScript <code>fetch</code> to list pre-alerts:</strong></p>
                <pre class="example">
fetch("https://waresync.onepluscourierja.com/api/prealert/list?page=1&perPage=10", {
  method: "GET",
  headers: {
    "Authorization": "Bearer YOUR_API_KEY",
    "Accept": "application/json"
  }
})
.then(res => res.json())
.then(data => console.log(data));
                </pre>

                <p><strong>Example using JavaScript <code>fetch</code> to delete a pre-alert:</strong></p>
                <pre class="example">
fetch("https://waresync.onepluscourierja.com/api/prealert/delete/encrypted_id_here", {
  method: "DELETE",
  headers: {
    "Authorization": "Bearer YOUR_API_KEY",
    "Accept": "application/json"
  }
})
.then(res => res.json())
.then(data => console.log(data));
                </pre>

                <h3 class="mt-4"><i class="bi bi-exclamation-triangle-fill"></i> Important Notes</h3>
                <ul>
                    <li>The ID must be the encrypted UUID returned from the list endpoint</li>
                    <li>Deletion is permanent and cannot be undone</li>
                    <li>Only pre-alerts belonging to your courier/company can be deleted</li>
                    <li>Deleting a pre-alert will also remove it from the external warehouse system</li>
                </ul>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function showAlert(message, type = 'danger') {
            const alertDiv = document.getElementById('alertMessage');
            alertDiv.className = `alert alert-${type} show`;
            alertDiv.textContent = message;
            setTimeout(() => {
                alertDiv.classList.remove('show');
            }, 5000);
        }

        async function searchPreAlerts() {
            const apiKey = document.getElementById('apiKey').value.trim();
            if (!apiKey) {
                showAlert('Please enter your API key.', 'danger');
                return;
            }

            const search = document.getElementById('search').value.trim();
            const status = document.getElementById('status').value;
            const page = document.getElementById('page').value;
            const perPage = document.getElementById('perPage').value;
            const sortBy = document.getElementById('sortBy').value;
            const sortDir = document.getElementById('sortDir').value;

            const url = new URL('https://waresync.onepluscourierja.com/api/prealert/list');
            url.searchParams.append('page', page);
            url.searchParams.append('perPage', perPage);
            if (search) url.searchParams.append('search', search);
            if (status) url.searchParams.append('status', status);
            url.searchParams.append('sortBy', sortBy);
            url.searchParams.append('sortDir', sortDir);

            const loading = document.getElementById('loading');
            const resultsTable = document.getElementById('resultsTable');
            
            loading.classList.add('show');
            resultsTable.style.display = 'none';

            try {
                const response = await fetch(url.toString(), {
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Accept': 'application/json',
                    },
                });

                const data = await response.json();
                
                if (!response.ok) {
                    throw new Error(data.error || response.statusText);
                }

                displayResults(data);
                document.getElementById('response').textContent = JSON.stringify(data, null, 2);
                showAlert(`Found ${data.meta.total} pre-alert(s)`, 'success');
            } catch (error) {
                document.getElementById('response').textContent = `Error: ${error.message}`;
                showAlert(`Error: ${error.message}`, 'danger');
                resultsTable.style.display = 'none';
            } finally {
                loading.classList.remove('show');
            }
        }

        function displayResults(data) {
            const tbody = document.getElementById('preAlertTableBody');
            const resultsTable = document.getElementById('resultsTable');
            
            if (!data.data || data.data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center">No pre-alerts found</td></tr>';
                resultsTable.style.display = 'block';
                document.getElementById('pagination').innerHTML = '';
                return;
            }

            tbody.innerHTML = data.data.map(preAlert => {
                const statusClass = getStatusClass(preAlert.status);
                const statusText = preAlert.status || 'pending';
                const matchScore = preAlert.match_score ? `${preAlert.match_score}%` : '-';
                
                return `
                    <tr>
                        <td><code>${preAlert.uuid || '-'}</code></td>
                        <td><strong>${escapeHtml(preAlert.tracking_no)}</strong></td>
                        <td>${escapeHtml(preAlert.merchant || '-')}</td>
                        <td>${escapeHtml(preAlert.consignee || '-')}</td>
                        <td>${preAlert.weight ? preAlert.weight + ' kg' : '-'}</td>
                        <td><span class="badge ${statusClass}">${statusText.toUpperCase()}</span></td>
                        <td>${matchScore}</td>
                        <td>
                            <button class="btn btn-sm btn-danger" onclick="deleteWithId('${preAlert.uuid}')">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            // Add pagination
            const pagination = document.getElementById('pagination');
            const meta = data.meta;
            
            if (meta.totalPages > 1) {
                pagination.innerHTML = `
                    <div>
                        <button class="btn btn-sm btn-secondary" onclick="changePage(${meta.page - 1})" ${meta.page === 1 ? 'disabled' : ''}>
                            <i class="bi bi-chevron-left"></i> Previous
                        </button>
                        <span class="mx-3">Page ${meta.page} of ${meta.totalPages}</span>
                        <button class="btn btn-sm btn-secondary" onclick="changePage(${meta.page + 1})" ${meta.page === meta.totalPages ? 'disabled' : ''}>
                            Next <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <div>
                        <span>Total: ${meta.total} records</span>
                    </div>
                `;
            } else {
                pagination.innerHTML = `<div><span>Total: ${meta.total} records</span></div>`;
            }

            resultsTable.style.display = 'block';
        }

        function getStatusClass(status) {
            switch(status) {
                case 'synced': return 'badge-synced';
                case 'matched': return 'badge-matched';
                case 'failed': return 'badge-danger';
                default: return 'badge-pending';
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function changePage(newPage) {
            document.getElementById('page').value = newPage;
            searchPreAlerts();
        }

        async function deletePreAlert() {
            const apiKey = document.getElementById('apiKey').value.trim();
            const encryptedId = document.getElementById('deleteId').value.trim();

            if (!apiKey || !encryptedId) {
                showAlert('Please enter both API key and encrypted ID.', 'danger');
                return;
            }

            if (!confirm('Are you sure you want to delete this pre-alert? This action cannot be undone.')) {
                return;
            }

            try {
                const response = await fetch(`/api/prealert/delete/${encodeURIComponent(encryptedId)}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Accept': 'application/json',
                    },
                });

                const data = await response.json();
                
                if (!response.ok) {
                    throw new Error(data.error || response.statusText);
                }

                document.getElementById('response').textContent = `Success:\n${JSON.stringify(data, null, 2)}`;
                showAlert('PreAlert deleted successfully!', 'success');
                
                // Refresh the list if it's currently displayed
                if (document.getElementById('resultsTable').style.display === 'block') {
                    searchPreAlerts();
                }
                
                // Clear the delete form
                clearDeleteForm();
            } catch (error) {
                document.getElementById('response').textContent = `Delete Error: ${error.message}`;
                showAlert(`Error: ${error.message}`, 'danger');
            }
        }

        function deleteWithId(encryptedId) {
            document.getElementById('deleteId').value = encryptedId;
            deletePreAlert();
        }

        function clearSearch() {
            document.getElementById('search').value = '';
            document.getElementById('status').value = '';
            document.getElementById('page').value = '1';
            document.getElementById('perPage').value = '10';
            document.getElementById('sortBy').value = 'created_at';
            document.getElementById('sortDir').value = 'desc';
            document.getElementById('resultsTable').style.display = 'none';
            document.getElementById('response').textContent = 'Waiting for request...';
        }

        function clearDeleteForm() {
            document.getElementById('deleteId').value = '';
        }

        // Optional: Load initial data when API key is entered
        document.getElementById('apiKey').addEventListener('change', function() {
            if (this.value.trim()) {
                searchPreAlerts();
            }
        });
    </script>
</body>
</html>