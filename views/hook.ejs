PHP Example
<pre class="example">

// Expected token
$expectedToken = "YOUR_SECRET_TOKEN";

// Get headers
$headers = getallheaders();

// Check Authorization header
if (!isset($headers['Authorization'])) {
    http_response_code(401);
    echo json_encode(['error' => 'Missing Authorization header']);
    exit;
}

// Extract Bearer token
$authHeader = $headers['Authorization'];
if (!preg_match('/Bearer\s(\S+)/', $authHeader, $matches)) {
    http_response_code(401);
    echo json_encode(['error' => 'Invalid Authorization format']);
    exit;
}

$token = $matches[1];

// Validate token
if ($token !== $expectedToken) {
    http_response_code(403);
    echo json_encode(['error' => 'Invalid token']);
    exit;
}

// Read raw JSON input
$input = file_get_contents('php://input');
$data = json_decode($input, true);

if (!isset($data['packages']) || !is_array($data['packages'])) {
    http_response_code(400);
    echo json_encode(['error' => 'No packages found']);
    exit;
}

// Loop through packages
foreach ($data['packages'] as $package) {
    $tracking = $package['tracking_number'] ?? null;
    $consignee = $package['consignee'] ?? null;
    $status = $package['status'] ?? null;

    // Example processing
    echo "Tracking: $tracking | Consignee: $consignee | Status: $status\n";
}

// Success response
echo json_encode(['success' => true]);

</pre>

