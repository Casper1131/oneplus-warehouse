<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

  <link rel="stylesheet" href="/styles.css">

        <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-32x32.png" sizes="32x32" />
        <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-16x16.png" sizes="16x16" />

  <style>
    a{
        text-decoration:none
    }
    body {
      background-color: #f8f9fa;
      font-family: 'Segoe UI', sans-serif;
    }
    .card {
      border-radius: 12px;
    }
    .section-title {
      margin-top: 3rem;
      margin-bottom: 1rem;
    }
    .endpoint {
      font-family: monospace;
      background: #e9ecef;
      padding: 4px 8px;
      border-radius: 6px;
    }
    .premium {
      font-size: 0.875rem;
      color: #d63384;
      font-weight: 500;
    }
    nav li{
        padding:4px;
        margin-bottom:10px
    }
  </style>
</head>
<body class="bg-light">

  <div class="d-flex" id="wrapper">
    <!-- Sidebar -->
    <%- include("sidebar") %>


    <!-- Page content -->
    <div id="page-content" class="p-4 w-100">
      <h2 class="fw-bold mb-4"><i class="bi bi-hand-thumbs-up me-2 text-primary"></i> Welcome back!</h2>
      <div class="card shadow-sm rounded-4 p-4">
        <h4 class="mb-3">Overview</h4>
        <p data-start="260" data-end="492">Our system provides a set of RESTful APIs and web pages designed to <strong data-start="328" data-end="373">facilitate synchronization and management</strong> of Couriers, Consignees, and Collection and Shipments. These APIs are organized into <strong data-start="444" data-end="457">endpoints</strong> and <strong data-start="462" data-end="471">pages</strong>, grouped by feature.</p>      </div>
        <h1 class="text-center fw-bold mb-4">
            <i class="bi bi-diagram-3-fill text-primary me-2"></i>API Reference
          </h1>
          <p class="text-muted text-center mb-5">
            <b>
The API Key can be generated from the Warehouse Courier List page 
(https://warehouse.onepluscourierja.com/courier/list). 

To generate the key, locate the desired courier in the list, click the red "Action" button associated with that courier, and then select the "API Key" option from the dropdown menu. 

Once selected, the system will generate an API Key that can be used to securely integrate and authenticate requests between the warehouse system and external applications.
<img src='data:image/png;base64,' width="100%">
</b>
          </p>
          <p class="text-muted text-center mb-5">
            Below are the available endpoints and pages to support syncing and management of couriers, consignees, and companies.
          </p>

          <!-- Courier Section -->
          <h4 class="section-title">
            <i class="bi bi-truck me-2 text-success"></i>Courier
          </h4>
          <div class="card p-3 mb-3">
            <h6><span class="endpoint">courier/sync</span></h6>
            <p class="text-muted mb-0">Sync courier data with external systems.</p>
          </div>

          <!-- Consignee Section -->
          <h4 class="section-title">
            <i class="bi bi-person-lines-fill me-2 text-info"></i>Consignee
          </h4>
          <div class="card p-3 mb-2">
            <h6><span class="endpoint">consignee/list</span></h6>
            <p class="text-muted mb-0">Get a list of all consignees.</p>
          </div>
          <div class="card p-3 mb-2">
            <h6><span class="endpoint">consignee/sync</span></h6>
            <p class="text-muted mb-0">Sync consignee data with external systems.</p>
          </div>
          <div class="card p-3 mb-2">
            <h6><span class="endpoint">consignee/add</span></h6>
            <p class="text-muted mb-0">Add a new consignee.</p>
          </div>
           <!-- Package Section -->
            <h4 class="section-title">
              <i class="bi bi-box-seam me-2 text-secondary"></i>Packages
            </h4>
            <div class="card p-3 mb-2">
              <h6><span class="endpoint">package/list</span></h6>
              <p class="text-muted mb-0">Retrieve a list of all packages linked to the courier or company.</p>
            </div>
            <div class="card p-3 mb-2">
              <h6><span class="endpoint">package/sync</span></h6>
              <p class="text-muted mb-0">Sync package data with external platforms.</p>
            </div>
          <!-- Webhooks Section -->
          <h4 class="section-title">
            <i class="bi bi-plug me-2 text-warning"></i>Webhooks
          </h4>
          <div class="card p-3 mb-2">
            <h6><span class="endpoint">courier/sync</span></h6>
            <p class="text-muted mb-0">Webhook to sync courier data.</p>
          </div>
          <div class="card p-3 mb-2">
            <h6><span class="endpoint">consignee/sync</span></h6>
            <p class="text-muted mb-0">Webhook to sync consignee data.</p>
          </div>
          <div class="card p-3 mb-2">
            <h6><span class="endpoint">package/sync</span></h6>
            <p class="text-muted mb-0">Webhook to sync packages for courier.</p>
          </div>
 <% if(setting && setting.is_premium){ %>
           <!-- Premium Section -->
            <h4 class="section-title">
              <i class="bi bi-stars me-2 text-danger"></i>Premium Endpoints
            </h4>
            <div class="card p-3 mb-2">
              <h6><span class="endpoint">collection/list</span> <span class="premium">(Premium users only)</span></h6>
              <p class="text-muted mb-0">Retrieve a full list of collections for reporting or auditing.</p>
            </div>
            <div class="card p-3 mb-2">
              <h6><span class="endpoint">shipment/list</span> <span class="premium">(Premium users only)</span></h6>
              <p class="text-muted mb-0">Get all shipments associated with the courier.</p>
            </div>
<% }; %>
        </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
