<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Webhooks</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
        <link rel="stylesheet" href="/styles.css">
        <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-32x32.png" sizes="32x32" />
        <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-16x16.png" sizes="16x16" />
        <style>
            a{
                text-decoration:none
            }
            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', sans-serif;
            }
            .card {
                border-radius: 12px;
            }
            .section-title {
                margin-top: 3rem;
                margin-bottom: 1rem;
            }
            .endpoint {
                font-family: monospace;
                background: #e9ecef;
                padding: 4px 8px;
                border-radius: 6px;
            }
            .premium {
                font-size: 0.875rem;
                color: #d63384;
                font-weight: 500;
            }
            nav li{
                padding:4px;
                margin-bottom:10px
            }
            h1 {
                font-weight: 700;
                color: #4b0082;
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            label {
                display: block;
                margin: 1rem 0 0.5rem 0;
                font-weight: 600;
                color: #555;
            }

            input[type='text'],
            input[type='number'] {
                width: 100%;
                padding: 0.5rem 0.75rem;
                border: 2px solid #ddd;
                border-radius: 6px;
                font-size: 1rem;
                transition: border-color 0.3s;
            }

            input[type='text']:focus,
            input[type='number']:focus {
                border-color: #764ba2;
                outline: none;
                box-shadow: 0 0 8px #a07ecf80;
            }

            button {
                margin-top: 1.5rem;
                background: #764ba2;
                color: white;
                font-weight: 600;
                padding: 0.75rem 1.8rem;
                font-size: 1.1rem;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                transition: background-color 0.3s;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            button:hover {
                background: #4b0082;
            }

            pre {
                background: #f6f8fa;
                padding: 1rem;
                border-radius: 8px;
                margin-top: 1rem;
                font-size: 0.9rem;
                max-height: 300px;
                overflow: auto;
                border: 1px solid #ddd;
                white-space: pre-wrap;
                word-wrap: break-word;
            }

            .instructions {
                margin-top: 3rem;
                border-top: 2px solid #764ba2;
                padding-top: 2rem;
                color: #333;
            }

            .instructions h2 {
                color: #764ba2;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-bottom: 1rem;
            }

            .tag {
                display: inline-block;
                background: #e1d7ff;
                color: #4b0082;
                font-weight: 700;
                padding: 0.15rem 0.5rem;
                border-radius: 5px;
                font-size: 0.85rem;
                margin-right: 0.5rem;
                font-family: monospace;
            }

            ul {
                margin-left: 1.25rem;
            }

            ul li {
                margin-bottom: 0.4rem;
                line-height: 1.4;
            }

            pre.example {
                background: #efefff;
                border-left: 5px solid #764ba2;
                padding-left: 1rem;
                font-family: monospace;
                font-size: 0.9rem;
                margin-bottom: 1rem;
            }
        </style>
    </head>
    <body class="bg-light">
        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <%- include("sidebar") %>

            <!-- Page content -->
            <div id="page-content" class="p-4 w-100">
                <h2 class="fw-bold mb-4">
                    <i class="bi bi-hand-thumbs-up me-2 text-primary"></i> courierSync/create
                </h2>

                <div class="card shadow-sm rounded-4 p-4">
                    <h4 class="mb-3">Overview</h4>
                    <p>
                        This interface allows you to create CourierSync entries for <strong>CONSIGNEE</strong>, 
                        <strong>PACKAGE</strong>, and <strong>COURIER</strong> sync types.
                    </p>
                </div>

                <div class="mb-3">
                    <label for="syncType" class="form-label"><i class="bi bi-arrow-repeat"></i> Sync Type</label>
                    <select id="syncType" class="form-select">
                        <option value="CONSIGNEE">CONSIGNEE</option>
                        <option value="PACKAGE">PACKAGE</option>
                        <option value="COURIER">COURIER</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="link" class="form-label"><i class="bi bi-link-45deg"></i> Webhook URL</label>
                    <input type="text" id="link" class="form-control" placeholder="https://..." />
                </div>

                <button class="btn btn-success" onclick="createCourierSync()">
                    <i class="bi bi-plus-circle"></i> Create Courier Sync
                </button>

                <h2 class="mt-4"><i class="bi bi-file-earmark-code"></i> Response</h2>
                <pre id="response">Waiting for request...</pre>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
          async function createCourierSync() {
              const synctype = document.getElementById('syncType').value;
              const link = document.getElementById('link').value;

              try {
                  const res = await fetch('/courier-sync', {
                      method: 'POST',
                      headers: {
                          'Content-Type': 'application/json',
                      },
                      body: JSON.stringify({synctype, link})
                  });

                  const data = await res.json();
                  document.getElementById('response').textContent = JSON.stringify(data, null, 2);
              } catch (err) {
                  document.getElementById('response').textContent = `Error: ${err.message}`;
              }
          }
        </script>

    </body>
</html>
