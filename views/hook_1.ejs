                    <div class="info-box">
                        <strong><i class="bi bi-code-slash"></i> PHP Webhook Handler Example</strong>
                        <pre class="example mt-2">
&lt;?php
// Expected token
$expectedToken = "YOUR_SECRET_TOKEN";

// Get headers
$headers = getallheaders();

// Check Authorization header
if (!isset($headers['Authorization'])) {
    http_response_code(401);
    echo json_encode(['error' => 'Missing Authorization header']);
    exit;
}

// Extract Bearer token
$authHeader = $headers['Authorization'];
if (!preg_match('/Bearer\s(\S+)/', $authHeader, $matches)) {
    http_response_code(401);
    echo json_encode(['error' => 'Invalid Authorization format']);
    exit;
}

$token = $matches[1];

// Validate token
if ($token !== $expectedToken) {
    http_response_code(403);
    echo json_encode(['error' => 'Invalid token']);
    exit;
}

// Read raw JSON input
$input = file_get_contents('php://input');
$data = json_decode($input, true);

// Handle different sync types
if (isset($data['prealerts'])) {
    // Handle PreAlert webhook
    foreach ($data['prealerts'] as $prealert) {
        $tracking = $prealert['tracking_no'] ?? null;
        $merchant = $prealert['merchant'] ?? null;
        $status = $prealert['status'] ?? null;
        $matchScore = $prealert['match_score'] ?? null;
        
        // Example processing for pre-alerts
        error_log("PreAlert: $tracking | Merchant: $merchant | Status: $status | Match: $matchScore%");
        
        // Store in your database or process accordingly
        // INSERT INTO prealerts (tracking_no, merchant, status, match_score) VALUES (...)
    }
} elseif (isset($data['packages'])) {
    // Handle Package webhook
    foreach ($data['packages'] as $package) {
        $tracking = $package['tracking_number'] ?? null;
        $consignee = $package['consignee'] ?? null;
        $status = $package['status'] ?? null;
        
        error_log("Package: $tracking | Consignee: $consignee | Status: $status");
    }
} elseif (isset($data['courier'])) {
    // Handle Courier webhook
    foreach ($data['courier'] as $courier) {
        $name = $courier['name'] ?? null;
        $code = $courier['code'] ?? null;
        
        error_log("Courier: $name | Code: $code");
    }
}

// Success response
echo json_encode(['success' => true]);
?&gt;
</pre>
