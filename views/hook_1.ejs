                <div class="card shadow-sm rounded-4 p-4 mt-4">
                    <h4 class="mb-3"><i class="bi bi-plug"></i> Configure Webhook</h4>
                    
                    <div class="mb-3">
                        <label for="syncType" class="form-label"><i class="bi bi-arrow-repeat"></i> Sync Type</label>
                        <select id="syncType" class="form-select">
                            <option value="CONSIGNEE">CONSIGNEE</option>
                            <option value="PACKAGE">PACKAGE</option>
                            <option value="PREALERT">PREALERT</option>
                            <option value="COURIER">COURIER</option>
                            <option value="KEY">KEY</option>
                            <% if(setting && setting.is_premium){ %>
                            <option value="SHIPMENT">SHIPMENT</option>
                            <option value="COLLECTION">COLLECTION</option>
                            <% }; %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="link" class="form-label"><i class="bi bi-link-45deg"></i> <span id="label">Webhook URL</span></label>
                        <input type="text" id="link" class="form-control" placeholder="https://your-domain.com/webhook-endpoint" />
                        <small class="text-muted">The system will send POST requests to this URL with the data payload</small>
                    </div>

                    <button class="btn btn-success" onclick="createCourierSync()">
                        <i class="bi bi-plus-circle"></i> Create Webhook Sync
                    </button>

                    <h2 class="mt-4"><i class="bi bi-file-earmark-code"></i> Response</h2>
                    <pre id="response">Waiting for request...</pre>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
        <script>
            const hooks = <%- JSON.stringify(hooks) %>
            var links = {};
            
            function showAlert(message, type = 'success') {
                const alertDiv = document.getElementById('alertMessage');
                alertDiv.className = `alert alert-${type} show`;
                alertDiv.textContent = message;
                setTimeout(() => {
                    alertDiv.classList.remove('show');
                }, 5000);
            }
            
            $(function(){
                hooks.forEach(function(item){
                    links[item.synctype] = item.link;
                });
                $("#syncType").change(function(ev){
                    var val = $(this).val();
                    if(links[val]){
                        $("#link").val(links[val]);
                    } else {
                        $("#link").val('');
                    }
                    
                    $('#label').text("Webhook URL");
                    if(val == 'KEY'){
                        $('#label').text("API Key");
                    }
                    
                    // Show helpful hints for different sync types
                    if(val == 'PREALERT'){
                        $('#link').attr('placeholder', 'https://your-domain.com/prealert-webhook');
                        showAlert('PreAlert webhooks will send tracking data, match scores, and status updates', 'info');
                    } else if(val == 'PACKAGE'){
                        $('#link').attr('placeholder', 'https://your-domain.com/package-webhook');
                    } else if(val == 'CONSIGNEE'){
                        $('#link').attr('placeholder', 'https://your-domain.com/consignee-webhook');
                    } else if(val == 'COURIER'){
                        $('#link').attr('placeholder', 'https://your-domain.com/courier-webhook');
                    }
                });
                $("#syncType").trigger("change");
            });
            
            async function createCourierSync() {
                const synctype = document.getElementById('syncType').value;
                const link = document.getElementById('link').value;
                
                if (!link && synctype !== 'KEY') {
                    showAlert('Please enter a webhook URL', 'danger');
                    return;
                }

                try {
                    const res = await fetch('/courier-sync', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({synctype, link})
                    });

                    const data = await res.json();
                    links[synctype] = link;
                    document.getElementById('response').textContent = JSON.stringify(data, null, 2);
                    
                    if (res.ok) {
                        showAlert(`${synctype} webhook created successfully!`, 'success');
                    } else {
                        showAlert(data.error || 'Failed to create webhook', 'danger');
                    }
                } catch (err) {
                    document.getElementById('response').textContent = `Error: ${err.message}`;
                    showAlert(`Error: ${err.message}`, 'danger');
                }
            }
        </script>
    </body>
</html>