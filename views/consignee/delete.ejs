<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Consignee/Delete</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-16x16.png" sizes="16x16" />
    <style>
            a{
                text-decoration:none
            }
            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', sans-serif;
            }
            .card {
                border-radius: 12px;
            }
            .section-title {
                margin-top: 3rem;
                margin-bottom: 1rem;
            }
            .endpoint {
                font-family: monospace;
                background: #e9ecef;
                padding: 4px 8px;
                border-radius: 6px;
            }
            .premium {
                font-size: 0.875rem;
                color: #d63384;
                font-weight: 500;
            }
            nav li{
                padding:4px;
                margin-bottom:10px
            }
            h1 {
                font-weight: 700;
                color: #4b0082;
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            label {
                display: block;
                margin: 1rem 0 0.5rem 0;
                font-weight: 600;
                color: #555;
            }

            input[type='text'],
            input[type='number'] {
                width: 100%;
                padding: 0.5rem 0.75rem;
                border: 2px solid #ddd;
                border-radius: 6px;
                font-size: 1rem;
                transition: border-color 0.3s;
            }

            input[type='text']:focus,
            input[type='number']:focus {
                border-color: #764ba2;
                outline: none;
                box-shadow: 0 0 8px #a07ecf80;
            }

            button {
                margin-top: 1.5rem;
                background: #764ba2;
                color: white;
                font-weight: 600;
                padding: 0.75rem 1.8rem;
                font-size: 1.1rem;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                transition: background-color 0.3s;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            button:hover {
                background: #4b0082;
            }

            pre {
                background: #f6f8fa;
                padding: 1rem;
                border-radius: 8px;
                margin-top: 1rem;
                font-size: 0.9rem;
                max-height: 300px;
                overflow: auto;
                border: 1px solid #ddd;
                white-space: pre-wrap;
                word-wrap: break-word;
            }

            .instructions {
                margin-top: 3rem;
                border-top: 2px solid #764ba2;
                padding-top: 2rem;
                color: #333;
            }

            .instructions h2 {
                color: #764ba2;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-bottom: 1rem;
            }

            .tag {
                display: inline-block;
                background: #e1d7ff;
                color: #4b0082;
                font-weight: 700;
                padding: 0.15rem 0.5rem;
                border-radius: 5px;
                font-size: 0.85rem;
                margin-right: 0.5rem;
                font-family: monospace;
            }

            ul {
                margin-left: 1.25rem;
            }

            ul li {
                margin-bottom: 0.4rem;
                line-height: 1.4;
            }

            pre.example {
                background: #efefff;
                border-left: 5px solid #764ba2;
                padding-left: 1rem;
                font-family: monospace;
                font-size: 0.9rem;
                margin-bottom: 1rem;
            }
        </style>
</head>
<body class="bg-light">
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <%- include("../sidebar") %>

        <!-- Page content -->
        <div id="page-content" class="p-4 w-100">
            <h2 class="fw-bold mb-4"><i class="bi bi-hand-thumbs-up me-2 text-primary"></i> collection/delete</h2>
            <div class="card shadow-sm rounded-4 p-4">
                <h4 class="mb-3">Overview</h4>
                <p>Our system provides RESTful APIs to manage Couriers, Consignees, and Collections. Use the fields below to fetch or delete records.</p>
            </div>

            <h1><i class="bi bi-box-seam"></i> Consignee API</h1>

            <!-- Inputs for GET -->
            <label for="apiKey"><i class="bi bi-key-fill"></i> API Key</label>
            <input type="text" id="apiKey" placeholder="Enter your Bearer API key here..." />


            <!-- Inputs for DELETE -->
            <label for="deleteId"><i class="bi bi-trash-fill"></i> Encrypted ID to Delete</label>
            <input type="text" id="deleteId" placeholder="Enter encrypted consignee ID..." />

            <button class="btn btn-danger" onclick="deleteConsignee()">
                <i class="bi bi-trash"></i> Delete Consignee
            </button>

            <h2><i class="bi bi-file-earmark-code"></i> Response</h2>
            <pre id="response">Waiting for request...</pre>

            <!-- Developer Instructions -->
            <div class="instructions">
                <!-- ... keep this section unchanged ... -->
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function fetchCollections() {
            const apiKey = document.getElementById('apiKey').value.trim();
            if (!apiKey) {
                alert('Please enter your API key.');
                return;
            }

            const search = document.getElementById('search').value.trim();
            const page = document.getElementById('page').value;
            const perPage = document.getElementById('perPage').value;
            const sortBy = document.getElementById('sortBy').value.trim();
            const sortDir = document.getElementById('sortDir').value.trim();

            const url = new URL('https://waresync.onepluscourierja.com/api/consignee/list');
            url.searchParams.append('page', page);
            url.searchParams.append('perPage', perPage);
            if (search) url.searchParams.append('search', search);
            url.searchParams.append('sortBy', sortBy);
            url.searchParams.append('sortDir', sortDir);

            try {
                const response = await fetch(url.toString(), {
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Accept': 'application/json',
                    },
                });

                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.error || response.statusText);
                }

                document.getElementById('response').textContent = JSON.stringify(data, null, 2);
            } catch (error) {
                document.getElementById('response').textContent = `Error: ${error.message}`;
            }
        }

        async function deleteConsignee() {
            const apiKey = document.getElementById('apiKey').value.trim();
            const encryptedId = document.getElementById('deleteId').value.trim();

            if (!apiKey || !encryptedId) {
                alert('Please enter both API key and encrypted ID.');
                return;
            }

            try {
                const response = await fetch(`/api/consignee/delete/${encodeURIComponent(encryptedId)}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Accept': 'application/json',
                    },
                });

                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.error || response.statusText);
                }

                document.getElementById('response').textContent = `Success:\n` + JSON.stringify(data, null, 2);
            } catch (error) {
                document.getElementById('response').textContent = `Delete Error: ${error.message}`;
            }
        }
    </script>
</body>
</html>
