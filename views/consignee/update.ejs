<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Consignee/Update</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="https://warehouse.onepluscourierja.com/images/favicon/favicon-16x16.png" sizes="16x16" />

    <style>
        a { text-decoration: none; }
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }
        .card { border-radius: 12px; }
        .section-title {
            margin-top: 3rem;
            margin-bottom: 1rem;
        }
        .endpoint {
            font-family: monospace;
            background: #e9ecef;
            padding: 4px 8px;
            border-radius: 6px;
        }
        .premium {
            font-size: 0.875rem;
            color: #d63384;
            font-weight: 500;
        }
        nav li {
            padding: 4px;
            margin-bottom: 10px;
        }
        h1 {
            font-weight: 700;
            color: #4b0082;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        label {
            display: block;
            margin: 1rem 0 0.5rem 0;
            font-weight: 600;
            color: #555;
        }
        input[type='text'],
        input[type='number'],
        input[type='email'] {
            width: 100%;
            padding: 0.5rem 0.75rem;
            border: 2px solid #ddd;
            border-radius: 6px;
            font-size: 1rem;
            transition: border-color 0.3s;
        }
        input:focus {
            border-color: #764ba2;
            outline: none;
            box-shadow: 0 0 8px #a07ecf80;
        }
        button {
            margin-top: 1.5rem;
            background: #764ba2;
            color: white;
            font-weight: 600;
            padding: 0.75rem 1.8rem;
            font-size: 1.1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        button:hover {
            background: #4b0082;
        }
        pre {
            background: #f6f8fa;
            padding: 1rem;
            border-radius: 8px;
            margin-top: 1rem;
            font-size: 0.9rem;
            max-height: 300px;
            overflow: auto;
            border: 1px solid #ddd;
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        .instructions {
            margin-top: 3rem;
            border-top: 2px solid #764ba2;
            padding-top: 2rem;
            color: #333;
        }
        .instructions h2 {
            color: #764ba2;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        .tag {
            display: inline-block;
            background: #e1d7ff;
            color: #4b0082;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 5px;
            font-size: 0.85rem;
            margin-right: 0.5rem;
            font-family: monospace;
        }
        ul {
            margin-left: 1.25rem;
        }
        ul li {
            margin-bottom: 0.4rem;
            line-height: 1.4;
        }
        pre.example {
            background: #efefff;
            border-left: 5px solid #764ba2;
            padding-left: 1rem;
            font-family: monospace;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body class="bg-light">

    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <%- include("../sidebar") %>

        <!-- Page content -->
        <div id="page-content" class="p-4 w-100">
            <h1><i class="bi bi-pencil-square"></i> Update Consignee</h1>

            <label for="apiKey">API Key</label>
            <input type="text" id="apiKey" placeholder="Bearer API Key" />

            <label for="consigneeId">Consignee ID</label>
            <input type="text" id="consigneeId" placeholder="ID of Consignee to Update" />

            <label for="firstName">First Name</label>
            <input type="text" id="firstName" placeholder="First Name" />

            <label for="lastName">Last Name</label>
            <input type="text" id="lastName" placeholder="Last Name" />

            <label for="mailbox">Mailbox</label>
            <input type="text" id="mailbox" placeholder="Mailbox ID" />

            <label for="branch">Branch (optional)</label>
            <input type="text" id="branch" placeholder="Branch Name" />

            <label for="email">Email (optional)</label>
            <input type="email" id="email" placeholder="Email Address" />

            <button onclick="updateConsignee()">
                <i class="bi bi-send"></i> Update
            </button>

            <pre id="response">Waiting for response...</pre>

            <div class="instructions">
                <h2><i class="bi bi-code-slash"></i> Developer Instructions (Without Widget)</h2>

                <p>Make a <span class="tag">PUT</span> request to:</p>
                <pre class="example">https://waresync.onepluscourierja.com/api/consignee/update/:id</pre>

                <p><strong>Authorization Header:</strong></p>
                <pre class="example">Authorization: Bearer YOUR_API_KEY</pre>

                <p><strong>Request Body:</strong> <span class="premium">(JSON)</span></p>
                <pre class="example">
{
  "first_name": "John",
  "last_name": "Doe",
  "mailbox": "MBX1234",
  "branch": "Kingston",
  "email": "john@example.com"
}
                </pre>

                <p><strong>Required Fields:</strong></p>
                <ul>
                    <li><code>first_name</code> — First name of the consignee</li>
                    <li><code>last_name</code> — Last name of the consignee</li>
                    <li><code>mailbox</code> — Mailbox identifier</li>
                </ul>

                <p><strong>Optional Fields:</strong></p>
                <ul>
                    <li><code>branch</code> — Name of the branch</li>
                    <li><code>email</code> — Email address of the consignee</li>
                </ul>

                <p><strong>Example using <code>curl</code>:</strong></p>
                <pre class="example">
curl -X PUT "https://waresync.onepluscourierja.com/api/consignee/update/123" \
     -H "Authorization: Bearer YOUR_API_KEY" \
     -H "Content-Type: application/json" \
     -d '{
           "first_name": "John",
           "last_name": "Doe",
           "mailbox": "MBX1234",
           "branch": "Kingston",
           "email": "john@example.com"
         }'
                </pre>

                <p><strong>Example using JavaScript <code>fetch</code>:</strong></p>
                <pre class="example">
fetch("https://waresync.onepluscourierja.com/api/consignee/update/123", {
  method: "PUT",
  headers: {
    "Content-Type": "application/json",
    "Authorization": "Bearer YOUR_API_KEY"
  },
  body: JSON.stringify({
    first_name: "John",
    last_name: "Doe",
    mailbox: "MBX1234",
    branch: "Kingston",
    email: "john@example.com"
  })
})
.then(res => res.json())
.then(data => console.log(data));
                </pre>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function updateConsignee() {
            const apiKey = document.getElementById('apiKey').value.trim();
            const id = document.getElementById('consigneeId').value.trim();
            const first_name = document.getElementById('firstName').value.trim();
            const last_name = document.getElementById('lastName').value.trim();
            const mailbox = document.getElementById('mailbox').value.trim();
            const branch = document.getElementById('branch').value.trim();
            const email = document.getElementById('email').value.trim();

            if (!apiKey || !id || !first_name || !last_name || !mailbox) {
                alert('API key, ID, First Name, Last Name, and Mailbox are required.');
                return;
            }

            const payload = { first_name, last_name, mailbox,id };
            if (branch) payload.branch = branch;
            if (email) payload.email = email;

            try {
                const response = await fetch(`https://waresync.onepluscourierja.com/api/consignee/update/${id}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                document.getElementById('response').textContent = JSON.stringify(result, null, 2);
            } catch (error) {
                document.getElementById('response').textContent = `Error: ${error.message}`;
            }
        }
    </script>
</body>
</html>
